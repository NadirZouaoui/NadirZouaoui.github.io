---
/**
 * The CV. Ported 1:1 from the original hand-written index.html (EN/FR, same markup, same CSS
 * incl. print). Changes vs the original: shared layout/head (Base), shared language script
 * (LangScript), portrait through Astro image handling, <ProjectLink> hooks (render nothing
 * until a project with the matching cvAnchor is published).
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectLink from '../components/ProjectLink.astro';
import portrait from '../assets/portrait.jpg';
---
