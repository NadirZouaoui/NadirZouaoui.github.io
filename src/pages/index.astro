<style is:global>
.page{max-width:46rem;margin:0 auto;padding:2rem 1.5rem 4rem}
.bar{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.5rem;font-size:.9rem}
.sw button{font:inherit;background:none;border:1px solid var(--rule);color:var(--muted);padding:.2rem .65rem;cursor:pointer}
.sw button:first-child{border-radius:4px 0 0 4px}.sw button:last-child{border-radius:0 4px 4px 0;border-left:0}
.sw button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}
.dl{display:inline-block;border:1px solid var(--accent);border-radius:4px;padding:.25rem .8rem;text-decoration:none;font-weight:500}
header{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;padding-bottom:1.75rem;border-bottom:1px solid var(--ink)}
.photo{width:120px;height:120px;border-radius:50%;object-fit:cover;flex:none}
h1{font-size:2.1rem;line-height:1.15;font-weight:600;letter-spacing:-.01em;margin:0}
.title{margin:.25rem 0 0;font-size:1.1rem;color:var(--muted)}
.contact{display:flex;flex-wrap:wrap;gap:.2rem 1.5rem;list-style:none;margin:1.1rem 0 0;padding:0;font-size:.95rem;color:var(--muted)}
.contact a{color:var(--ink)}
section{padding-top:2rem}
h2{font-size:.95rem;font-weight:600;color:var(--accent);margin:0 0 1rem;padding-bottom:.4rem;border-bottom:1px solid var(--rule)}
p{margin:0}
.entry+.entry{margin-top:1.6rem}
.head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem}
h3{font-size:1rem;font-weight:600;margin:0}
.when{color:var(--muted);font-size:.92rem;white-space:nowrap}
.org{color:var(--muted);font-size:.95rem}
ul{margin:.55rem 0 0;padding-left:1.15rem}li{margin:.3rem 0}
.entry p+p,.entry .org+p{margin-top:.45rem}
.brief .head{padding:.35rem 0;border-top:1px solid var(--rule)}
.brief .head:first-child{border-top:0}
.brief h3{font-weight:500}
.brief small{color:var(--muted);font-size:.92rem}
dl.facts{display:grid;grid-template-columns:9rem minmax(0,1fr);gap:.55rem 1.25rem;margin:0}
dl.facts dt{font-weight:600}dl.facts dd{margin:0}
#li-badge{margin-top:.5rem}
@media (max-width:560px){
  .head{flex-direction:column;gap:0}.photo{width:88px;height:88px}
  dl.facts{grid-template-columns:1fr;gap:0}dl.facts dd{margin-bottom:.7rem}
}
@page{size:A4;margin:14mm 15mm}
@media print{
  .noprint,#li{display:none!important}
  .page{padding:0;max-width:none}body{font-size:10pt;line-height:1.45}
  section{padding-top:1.1rem}.entry+.entry{margin-top:1rem}
  .photo{width:90px;height:90px}h1{font-size:1.8rem}
  a{color:inherit;text-decoration:none}
}
</style>
