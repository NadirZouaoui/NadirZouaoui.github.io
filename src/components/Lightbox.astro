---
/**
 * Accessible image lightbox, no dependencies. Include ONCE per page that has a <Gallery> or <DrawingStrip>.
 *
 *  - Native modal <dialog>: Esc closes, background is inert, focus is restored to the thumbnail on close.
 *  - Keyboard: Left/Right (or the buttons) move between images of the same group, Home/End jump, Esc closes.
 *  - Focus trap: Tab and Shift+Tab cycle between the dialog buttons.
 *  - Touch: swipe left/right. Click on the dark area closes.
 *  - Alt text and captions follow the page language (data-alt-*, data-cap-* on the thumbnails).
 */
---
<dialog id="lightbox" class="lb" aria-label="Image viewer / Visionneuse d'images">
  <div class="lb-top">
    <span class="lb-count" aria-live="polite"></span>
    <button type="button" class="lb-btn lb-close" data-lb="close" aria-label="Close" data-label-en="Close" data-label-fr="Fermer">&times;</button>
  </div>
  <div class="lb-stage">
    <button type="button" class="lb-btn lb-prev" data-lb="prev" aria-label="Previous image" data-label-en="Previous image" data-label-fr="Image précédente">&#8249;</button>
    <figure class="lb-fig">
      <img class="lb-img" alt="" />
      <figcaption>
        <p lang="en" class="lb-cap-en"></p>
        <p lang="fr" class="lb-cap-fr"></p>
      </figcaption>
    </figure>
    <button type="button" class="lb-btn lb-next" data-lb="next" aria-label="Next image" data-label-en="Next image" data-label-fr="Image suivante">&#8250;</button>
  </div>
</dialog>

<style>
  .lb{position:fixed;inset:0;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;border:0;background:rgba(15,20,27,.95);color:#fff}
  .lb[open]{display:flex;flex-direction:column}
  .lb::backdrop{background:rgba(15,20,27,.95)}
  .lb-top{display:flex;justify-content:space-between;align-items:center;padding:.5rem 1rem;font-size:.9rem}
  .lb-stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;gap:.5rem;padding:0 .5rem .75rem}
  .lb-fig{flex:1;min-width:0;height:100%;margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.6rem}
  .lb-img{max-width:100%;max-height:calc(100% - 3.5rem);object-fit:contain;background:#fff}
  figcaption{min-height:2.5rem;max-width:60rem;text-align:center;font-size:.95rem;line-height:1.4}
  figcaption p{margin:0}
  .lb-btn{font:inherit;background:transparent;border:1px solid rgba(255,255,255,.5);color:#fff;cursor:pointer;border-radius:4px;line-height:1;width:2.75rem;height:2.75rem;font-size:1.75rem;flex:none}
  .lb-btn:hover{background:rgba(255,255,255,.15)}
  .lb-btn:focus-visible{outline:2px solid #fff;outline-offset:2px}
  .lb-btn[hidden]{display:none}
  @media (max-width:40rem){
    .lb-stage{position:relative}
    .lb-prev,.lb-next{position:absolute;bottom:.25rem;z-index:1;background:rgba(15,20,27,.8)}
    .lb-prev{left:.75rem}.lb-next{right:.75rem}
    .lb-img{max-height:calc(100% - 6rem)}
  }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const img = dlg.querySelector('.lb-img') as HTMLImageElement;
    const capEn = dlg.querySelector('.lb-cap-en') as HTMLElement;
    const capFr = dlg.querySelector('.lb-cap-fr') as HTMLElement;
    const count = dlg.querySelector('.lb-count') as HTMLElement;
    const prev = dlg.querySelector('[data-lb="prev"]') as HTMLButtonElement;
    const next = dlg.querySelector('[data-lb="next"]') as HTMLButtonElement;
    let group: HTMLElement[] = [];
    let idx = 0;
    let opener: HTMLElement | null = null;

    const lang = () => (document.documentElement.dataset.lang === 'fr' ? 'fr' : 'en');

    function show() {
      const t = group[idx];
      img.src = t.dataset.lbFull || '';
      img.alt = (lang() === 'fr' ? t.dataset.lbAltFr : t.dataset.lbAltEn) || '';
      img.dataset.altEn = t.dataset.lbAltEn || '';
      img.dataset.altFr = t.dataset.lbAltFr || '';
      capEn.textContent = t.dataset.lbCapEn || '';
      capFr.textContent = t.dataset.lbCapFr || '';
      count.textContent = group.length > 1 ? `${idx + 1} / ${group.length}` : '';
      prev.hidden = next.hidden = group.length < 2;
      // warm the neighbours
      [idx - 1, idx + 1].forEach((i) => {
        const n = group[(i + group.length) % group.length];
        if (n && n !== t) new Image().src = n.dataset.lbFull || '';
      });
    }
    function step(d: number) {
      if (group.length < 2) return;
      idx = (idx + d + group.length) % group.length;
      show();
    }
    function open(t: HTMLElement) {
      opener = t;
      const name = t.dataset.lightboxGroup;
      group = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-group]')).filter((e) => e.dataset.lightboxGroup === name);
      idx = Math.max(0, group.indexOf(t));
      show();
      dlg!.showModal();
      (group.length > 1 ? next : (dlg!.querySelector('[data-lb="close"]') as HTMLElement)).focus();
    }

    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-group]');
      if (t) open(t);
    });

    dlg.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      const act = el.closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (act === 'close') dlg.close();
      else if (act === 'prev') step(-1);
      else if (act === 'next') step(1);
      else if (el === dlg || el.classList.contains('lb-stage') || el.classList.contains('lb-fig')) dlg.close(); // dark area
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      else if (e.key === 'Home' && group.length > 1) { e.preventDefault(); idx = 0; show(); }
      else if (e.key === 'End' && group.length > 1) { e.preventDefault(); idx = group.length - 1; show(); }
      else if (e.key === 'Tab') {
        // focus trap: cycle between the visible buttons
        const f = Array.from(dlg.querySelectorAll<HTMLElement>('button')).filter((b) => !b.hidden);
        const first = f[0], last = f[f.length - 1];
        const a = document.activeElement;
        if (e.shiftKey && (a === first || !dlg.contains(a))) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && (a === last || !dlg.contains(a))) { e.preventDefault(); first.focus(); }
      }
    });

    // swipe
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
    }, { passive: true });

    dlg.addEventListener('close', () => {
      img.removeAttribute('src');
      if (opener) opener.focus();
      opener = null;
    });
  }
</script>
