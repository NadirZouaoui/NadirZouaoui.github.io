---
/**
 * Screen-only hub under the CV header: three tiles (CV, Projects, Training simulators).
 * Same render rule as SiteNav: the Projects / Simulators tile only when its collection has a
 * visible entry; nothing at all when neither does (the CV page is then exactly what it was).
 * The wrapper is `.noprint`, so nothing of it is ever printed.
 * Only <div>/<span>/<strong>/<a> are used: index.astro has global bare element selectors.
 */
import { Picture } from 'astro:assets';
import { getProjects, getSimulators } from '../lib/content';
import Lang from './Lang.astro';

/** Project whose cover illustrates the Projects tile (entry id = slug). Falls back to the first project when absent (e.g. unpublished). */
const HUB_PROJECT = 'ifri-pv';

const projects = await getProjects();
const simulators = await getSimulators();
const hubProject = projects.find((p) => p.id === HUB_PROJECT) ?? projects[0];
const firstSimulator = simulators[0];
const simCover = firstSimulator?.data.cover;
const simPoster = firstSimulator?.data.clips[0]?.poster;
const show = projects.length > 0 || simulators.length > 0;
const cols = 1 + (projects.length > 0 ? 1 : 0) + (simulators.length > 0 ? 1 : 0);
const sizes = '(max-width: 560px) 7rem, 14rem';
const widths = [240, 480];
---
{show && (
  <nav class:list={['hub', 'noprint', { two: cols === 2 }]} aria-label="Sections" data-label-en="Sections" data-label-fr="Rubriques">
    <div class="hub-grid">
      <a class="hub-tile" href="#cv">
        <div class="hub-pic hub-facts" aria-hidden="true">
          <div class="hub-fact"><strong><Lang en="4 years" fr="4 ans" /></strong><span class="hub-lbl"><Lang en="of experience" fr="d'expérience" /></span></div>
          <div class="hub-fact"><strong>1 MWp+</strong><span class="hub-lbl"><Lang en="of PV delivered" fr="de PV réalisés" /></span></div>
          <div class="hub-fact"><strong>EEHA</strong><span class="hub-lbl"><Lang en="hazardous areas, 2026" fr="zones dangereuses, 2026" /></span></div>
        </div>
        <div class="hub-body">
          <div class="hub-row"><strong class="hub-name">CV</strong></div>
          <div class="hub-desc"><Lang en="Experience, certifications, education and skills." fr="Expérience, certifications, formation et compétences." /></div>
          <div class="hub-act"><Lang en="Read below" fr="Lire ci-dessous" /><span class="hub-arr down" aria-hidden="true">↓</span></div>
        </div>
      </a>
      {hubProject && (
        <a class="hub-tile" href="/projects/">
          <div class="hub-pic">
            <Picture src={hubProject.data.cover} alt="" widths={widths} sizes={sizes} width={480} height={300}
              formats={['avif', 'webp']} fallbackFormat="jpg" loading="eager" decoding="async" />
          </div>
          <div class="hub-body">
            <div class="hub-row">
              <strong class="hub-name"><Lang en="Projects" fr="Projets" /></strong>
              <span class="hub-count"><Lang en={`${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`} fr={`${projects.length} projet${projects.length === 1 ? '' : 's'}`} /></span>
            </div>
            <div class="hub-desc"><Lang en="Selected engineering work: context, role and result." fr="Sélection de travaux d'ingénierie : contexte, rôle et résultat." /></div>
            <div class="hub-act"><Lang en="See the projects" fr="Voir les projets" /><span class="hub-arr" aria-hidden="true">→</span></div>
          </div>
        </a>
      )}
      {firstSimulator && (
        <a class="hub-tile" href="/simulators/">
          <div class="hub-pic">
            {simCover ? (
              <Picture src={simCover} alt="" widths={widths} sizes={sizes} width={480} height={300}
                formats={['avif', 'webp']} fallbackFormat="jpg" loading="eager" decoding="async" />
            ) : simPoster ? (
              <img src={simPoster} alt="" width="800" height="450" loading="eager" decoding="async" />
            ) : null}
          </div>
          <div class="hub-body">
            <div class="hub-row">
              <strong class="hub-name"><Lang en="Training simulators" fr="Simulateurs de formation" /></strong>
              <span class="hub-count"><Lang en={`${simulators.length} ${simulators.length === 1 ? 'module' : 'modules'}`} fr={`${simulators.length} module${simulators.length === 1 ? '' : 's'}`} /></span>
            </div>
            <div class="hub-desc"><Lang en="3D procedure trainers, shown as short clips of the real simulation." fr="Simulateurs 3D de procédures, présentés par de courts extraits de la simulation réelle." /></div>
            <div class="hub-act"><Lang en="See the simulators" fr="Voir les simulateurs" /><span class="hub-arr" aria-hidden="true">→</span></div>
          </div>
        </a>
      )}
    </div>
  </nav>
)}

<style>
  .hub{margin-top:1.75rem}
  .hub-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .hub.two .hub-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .hub-tile{display:flex;flex-direction:column;min-width:0;border:1px solid var(--rule);border-radius:8px;overflow:hidden;background:#fff;color:var(--ink);text-decoration:none;transition:border-color .15s,box-shadow .2s,transform .2s}
  .hub-tile:hover,.hub-tile:focus-visible{border-color:var(--accent);box-shadow:var(--lift)}
  .hub-pic{position:relative;aspect-ratio:8/5;background:#f3f4f6;overflow:hidden;line-height:0}
  .hub-pic :global(img){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
  /* CV tile: three facts as ruled rows, figure column + label column */
  .hub-facts{background:var(--accent);color:#fff;line-height:1.15;display:flex;flex-direction:column;padding:0 .9rem}
  .hub-fact{flex:1;display:grid;grid-template-columns:4.6rem minmax(0,1fr);align-items:center;column-gap:.6rem}
  .hub-fact+.hub-fact{border-top:1px solid rgba(255,255,255,.2)}
  .hub-fact strong{font-size:1rem;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
  .hub-lbl{font-size:.72rem;color:rgba(255,255,255,.8)}
  .hub-body{padding:.8rem .9rem;display:flex;flex-direction:column;gap:.3rem;flex:1;min-width:0}
  .hub-row{display:flex;justify-content:space-between;align-items:baseline;gap:.5rem}
  .hub-name{font-size:1rem;font-weight:600;line-height:1.3}
  .hub-count{font-size:.78rem;color:var(--muted);white-space:nowrap}
  .hub-desc{font-size:.88rem;line-height:1.4;color:var(--muted)}
  .hub-act{margin-top:auto;padding-top:.25rem;font-size:.9rem;font-weight:500;color:var(--accent)}
  .hub-arr{display:inline-block;margin-left:.3em;transition:transform .2s}
  /* motion: only without a reduced-motion preference */
  @media (prefers-reduced-motion:no-preference){
    .hub-tile:hover,.hub-tile:focus-visible{transform:translateY(-3px)}
    .hub-tile:hover .hub-pic :global(img),.hub-tile:focus-visible .hub-pic :global(img){transform:scale(1.05)}
    .hub-tile:hover .hub-arr,.hub-tile:focus-visible .hub-arr{transform:translateX(4px)}
    .hub-tile:hover .hub-arr.down,.hub-tile:focus-visible .hub-arr.down{transform:translateY(4px)}
    /* entrance on first paint: pure CSS; "backwards" fill so the tile's own hover transform works afterwards */
    .hub-tile{animation:hub-in .5s ease-out backwards}
    .hub-tile:nth-child(1){animation-delay:.1s}
    .hub-tile:nth-child(2){animation-delay:.17s}
    .hub-tile:nth-child(3){animation-delay:.24s}
    @keyframes hub-in{from{opacity:0;transform:translateY(12px)}}
  }
  @media (max-width:560px){
    .hub-grid{grid-template-columns:1fr;gap:.7rem}
    .hub.two .hub-grid{grid-template-columns:1fr}
    .hub-tile{flex-direction:row}
    .hub-pic{width:7rem;flex:none;aspect-ratio:auto;align-self:stretch;min-height:4.6rem}
    .hub-facts{padding:.2rem .6rem}
    .hub-fact{grid-template-columns:1fr;padding:.15rem 0}
    .hub-fact strong{font-size:.85rem}
    .hub-lbl{display:none}
    .hub-body{padding:.6rem .75rem;gap:.2rem}
    .hub-desc{font-size:.84rem}
    .hub-act{font-size:.85rem}
  }
</style>
