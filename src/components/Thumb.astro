---
/**
 * One clickable thumbnail that opens the page's <Lightbox>. Used by Gallery and DrawingStrip.
 * The large image, alt text and caption (both languages) travel as data-* attributes.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  image: ImageMetadata;
  alt: { en: string; fr: string };
  caption: { en: string; fr: string };
  group: string;
  index: number;
  total: number;
  /** thumbnail widths and sizes attribute */
  widths: number[];
  sizes: string;
  /** thumbnail intrinsic size (CSS decides the displayed size) */
  width: number;
  height: number;
}
const { image, alt, caption, group, index, total, widths, sizes, width, height } = Astro.props;
const full = await getImage({ src: image, width: Math.min(1800, image.width), format: 'webp', quality: 82 });
const n = index + 1;
---
<button
  type="button"
  class="thumb"
  data-lightbox-group={group}
  data-lb-full={full.src}
  data-lb-alt-en={alt.en}
  data-lb-alt-fr={alt.fr}
  data-lb-cap-en={caption.en}
  data-lb-cap-fr={caption.fr}
  data-label-en={`Enlarge image ${n} of ${total}${alt.en ? ': ' + alt.en : ''}`}
  data-label-fr={`Agrandir l'image ${n} sur ${total}${alt.fr ? ' : ' + alt.fr : ''}`}
  aria-label={`Enlarge image ${n} of ${total}${alt.en ? ': ' + alt.en : ''}`}
>
  <Picture
    src={image}
    alt={alt.en}
    data-alt-en={alt.en}
    data-alt-fr={alt.fr}
    widths={widths}
    sizes={sizes}
    width={width}
    height={height}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading="lazy"
    decoding="async"
  />
</button>

<style>
  .thumb{display:block;width:100%;height:100%;padding:0;margin:0;border:1px solid var(--rule);background:#f3f4f6;cursor:zoom-in;font:inherit;line-height:0}
  .thumb :global(img){width:100%;height:100%;object-fit:var(--thumb-fit,cover);display:block}
  .thumb:hover{border-color:var(--accent)}
</style>
