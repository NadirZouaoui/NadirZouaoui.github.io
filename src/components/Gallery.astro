---
/**
 * Photo gallery in justified rows: every photo keeps its own ratio (portrait or landscape, no cropping),
 * the photos of a row share one height and the row fills the width. Each thumbnail opens the page's <Lightbox>.
 * Pure CSS: flex-grow and flex-basis are both proportional to the photo ratio, which gives equal heights in a row.
 */
import type { ImageMetadata } from 'astro';
import Thumb from './Thumb.astro';
import Lang from './Lang.astro';

export interface Props {
  items: { image: ImageMetadata; alt: { en: string; fr: string }; caption: { en: string; fr: string } }[];
  /** lightbox group name; one per Gallery/DrawingStrip on a page */
  group?: string;
}
const { items, group = 'gallery' } = Astro.props;
---
<ul class="gallery">
  {items.map((it, i) => {
    const ratio = it.image.width / it.image.height;
    const h = 600;
    return (
      <li style={`--r:${ratio.toFixed(4)}`}>
        <div class="frame">
          <Thumb image={it.image} alt={it.alt} caption={it.caption} group={group} index={i} total={items.length}
            widths={[400, 800]} sizes={`(min-width: 40rem) ${Math.ceil(ratio * 23)}rem, ${ratio > 1 ? '100vw' : '50vw'}`}
            width={Math.round(h * ratio)} height={h} />
        </div>
        {(it.caption.en || it.caption.fr) && <p class="cap"><Lang en={it.caption.en} fr={it.caption.fr} /></p>}
      </li>
    );
  })}
</ul>

<style>
  /* --h: target row height; --hmax: a row never grows taller than this (it is then left short instead) */
  .gallery{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:1.25rem;--h:17.5rem;--hmax:23rem}
  /* filler: keeps the photos of the last row at the target height instead of stretching them */
  .gallery::after{content:"";flex:1000 0 0}
  li{margin:0;min-width:0;flex:var(--r) 1 calc(var(--r) * var(--h));max-width:min(100%,calc(var(--r) * var(--hmax)))}
  .frame{aspect-ratio:var(--r)}
  .cap{margin:.4rem 0 0;font-size:.9rem;color:var(--muted)}
  /* phones: two portrait photos side by side, a landscape photo on its own row */
  @media (max-width:40rem){.gallery{--h:11.5rem;gap:1rem .75rem}}
</style>
