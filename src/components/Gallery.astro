---
/**
 * Photo grid on strict columns: every tile of a row has the same height, so photos and captions line up.
 * The tile shape follows the majority of the photos: portrait (3:4) or landscape (4:3). In a portrait grid a
 * landscape photo spans two columns instead of being cropped to a sliver. Thumbnails are cropped to the tile
 * (object-fit: cover); the page's <Lightbox> shows the whole photo.
 * Photos stay in order; a row that is not full is centred.
 */
import type { ImageMetadata } from 'astro';
import Thumb from './Thumb.astro';
import Lang from './Lang.astro';

export interface Props {
  items: { image: ImageMetadata; alt: { en: string; fr: string }; caption: { en: string; fr: string } }[];
  /** lightbox group name; one per Gallery/DrawingStrip on a page */
  group?: string;
}
const { items, group = 'gallery' } = Astro.props;
const portrait = items.filter((it) => it.image.height > it.image.width).length * 2 > items.length;
const sizes = {
  portrait: '(min-width: 68rem) 13rem, (min-width: 56rem) 25vw, (min-width: 40rem) 33vw, 50vw',
  wide: '(min-width: 68rem) 27rem, (min-width: 56rem) 50vw, (min-width: 40rem) 66vw, 100vw',
  landscape: '(min-width: 68rem) 17rem, (min-width: 52rem) 33vw, (min-width: 34rem) 50vw, 100vw',
};
---
<ul class:list={['gallery', portrait && 'portrait']}>
  {items.map((it, i) => {
    const wide = portrait && it.image.width / it.image.height > 1.2;
    const [w, h] = wide ? [900, 600] : portrait ? [600, 800] : [800, 600];
    return (
      <li class:list={[wide && 'wide']}>
        <div class="frame">
          <Thumb image={it.image} alt={it.alt} caption={it.caption} group={group} index={i} total={items.length}
            widths={[400, 800]} sizes={wide ? sizes.wide : portrait ? sizes.portrait : sizes.landscape} width={w} height={h} />
        </div>
        {(it.caption.en || it.caption.fr) && <p class="cap"><Lang en={it.caption.en} fr={it.caption.fr} /></p>}
      </li>
    );
  })}
</ul>

<style>
  /* flex row, so a row that is not full is centred. --w is one tile; the -.02px keeps rounding from pushing the last tile of a full row onto the next line */
  .gallery{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:1.25rem var(--gap);container-type:inline-size;--gap:1.25rem;--cols:1;--w:calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols) - .02px)}
  li{flex:none;width:var(--w);margin:0;min-width:0}
  .frame{aspect-ratio:4/3}
  .cap{margin:.4rem 0 0;font-size:.9rem;color:var(--muted)}
  @media (min-width:34rem){.gallery{--cols:2}}
  @media (min-width:52rem){.gallery{--cols:3}}
  @media (min-width:68rem){.gallery{--cols:4}}

  /* portrait grid: narrower tiles, one more column; a landscape photo takes two columns */
  .portrait{--cols:2;--gap:.75rem}
  .portrait .frame{aspect-ratio:3/4}
  .portrait .wide{width:calc(2 * var(--w) + var(--gap))}
  .portrait .wide .frame{aspect-ratio:3/2}
  /* exact tile height from the column width, so a two-column photo is as tall as its neighbours */
  @supports (height:1cqw){.portrait .frame,.portrait .wide .frame{aspect-ratio:auto;height:calc(var(--w) * 4 / 3)}}
  @media (min-width:40rem){.portrait{--cols:3;--gap:1.25rem}}
  @media (min-width:56rem){.portrait{--cols:4}}
  @media (min-width:68rem){.portrait{--cols:5}}
</style>
