---
/** Module card on /simulators/. Image = cover, else the poster of the first clip. */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Lang from './Lang.astro';
import { STATUS_LABELS } from '../lib/content';

export interface Props {
  simulator: CollectionEntry<'simulators'>;
}
const { simulator } = Astro.props;
const d = simulator.data;
const poster = d.clips[0]?.poster;
const alt = d.coverAlt.en || d.title.en;
const altFr = d.coverAlt.fr || d.title.fr;
---
<li class="card">
  <div class="img">
    {d.cover ? (
      <Picture src={d.cover} alt={alt} data-alt-en={alt} data-alt-fr={altFr} widths={[480, 800, 1200]}
        sizes="(min-width: 72rem) 35rem, (min-width: 52rem) 50vw, 100vw" width={1200} height={750}
        formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
    ) : poster ? (
      <img src={poster} alt={alt} data-alt-en={alt} data-alt-fr={altFr} width="800" height="450" loading="lazy" decoding="async" />
    ) : null}
  </div>
  <div class="body">
    <h2><a href={`/simulators/${simulator.id}/`}><Lang en={d.title.en} fr={d.title.fr} /></a></h2>
    <p class="status"><Lang en={STATUS_LABELS[d.status].en} fr={STATUS_LABELS[d.status].fr} /></p>
    <p class="sum"><Lang en={d.summary.en} fr={d.summary.fr} /></p>
    {d.tech.length > 0 && <ul class="tags">{d.tech.map((t) => <li>{t}</li>)}</ul>}
  </div>
</li>

<style>
  .card{position:relative;display:flex;flex-direction:column;border:1px solid var(--rule);background:#fff;margin:0}
  .card:hover{border-color:var(--accent)}
  .img{aspect-ratio:8/5;background:#f3f4f6;overflow:hidden;line-height:0}
  .img :global(img){width:100%;height:100%;object-fit:cover;display:block}
  .body{padding:1rem 1.1rem 1.1rem;display:flex;flex-direction:column;gap:.45rem;flex:1}
  h2{font-size:1.1rem;font-weight:600;line-height:1.3;margin:0}
  h2 a{color:var(--ink);text-decoration:none}
  h2 a::after{content:"";position:absolute;inset:0}
  h2 a:hover{color:var(--accent);text-decoration:underline}
  h2 a:focus-visible{outline:none}
  .card:focus-within{outline:2px solid var(--accent);outline-offset:2px}
  .status{font-size:.9rem;color:var(--muted)}
  .sum{font-size:.95rem}
  .tags{margin-top:auto;padding-top:.4rem}
</style>
